APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost
RELEASE_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eyecare_backend_v2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null
SINGLE_SESSION_ENABLED=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Catalog files use the public logical disk by default. For Cloud object
# storage, set CATALOG_DRIVER=s3 and provide CATALOG_ROOT/CATALOG_URL when the
# provider does not inject compatible AWS_* values.
CATALOG_DISK=public
CATALOG_DRIVER=local
# CATALOG_ROOT=catalog
# CATALOG_URL=https://cdn.example.com
MESSAGE_ATTACHMENTS_DISK=message_attachments
# Set MESSAGE_ATTACHMENTS_DRIVER=s3 and the MESSAGE_ATTACHMENTS_* S3 values
# when object storage is selected; the default local root is private.
# MESSAGE_ATTACHMENTS_ROOT=/var/lib/eyecare/message-attachments
# AR assets are isolated by logical disk and visibility. Cloud object storage
# can use AR_QUARANTINE_DRIVER=s3 and AR_PUBLISHED_DRIVER=s3 with separate
# roots; credentials fall back to the AWS_* values below.
AR_QUARANTINE_DISK=ar_quarantine
AR_QUARANTINE_DRIVER=local
# AR_QUARANTINE_ROOT=ar/quarantine
AR_PUBLISHED_DISK=ar_published
AR_PUBLISHED_DRIVER=local
# AR_PUBLISHED_ROOT=ar
AR_ASSET_BASE_URL=
# AR_PUBLISHED_URL=https://cdn.example.com
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production-only deployment boundaries and operator checks
DEPLOYMENT_MODE=demo
# Keep false for the staff-only demo and participant-code pilot. Set true only
# with DEPLOYMENT_MODE=patient-demo and an enabled SMS provider.
PHONE_AUTH_ENABLED=false
TRUSTED_HOSTS=
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
PILOT_READINESS_TOKEN=
UPTIME_ALERT_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CAPSTONE_PILOT_ENABLED=false
CAPSTONE_PILOT_EXPIRES_AT=
CAPSTONE_PILOT_PARTICIPANT_LIMIT=75
CAPSTONE_PILOT_CREDENTIAL_DISK=local
CAPSTONE_PILOT_LOGIN_IP_RATE_LIMIT=10
CAPSTONE_PILOT_LOGIN_CODE_RATE_LIMIT=5

# Configure only the selected SMS adapter; keep disabled for the staff-only
# demo and participant-code pilot. Enable only for patient-demo after the
# provider, endpoint, credentials, sender, and retry policy have been reviewed.
SMS_DRIVER=semaphore
SEMAPHORE_ENABLED=false
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=PadillaOptical
SEMAPHORE_ENDPOINT=https://api.semaphore.co/api/v4/messages
SEMAPHORE_TIMEOUT=10
SEMAPHORE_RETRIES=2
TEXTBEE_ENABLED=false
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_ENDPOINT=https://api.textbee.dev/api/v1/gateway/send-sms
TEXTBEE_TIMEOUT=10
TEXTBEE_RETRIES=2
